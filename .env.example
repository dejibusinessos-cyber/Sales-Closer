# Server
PORT=3000

# Anthropic (Claude) — create a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# WhatsApp Cloud API — from your Meta App dashboard (developers.facebook.com)
# See README.md for exactly where each of these comes from.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Dashboard protection (HTTP Basic Auth) — pick your own values.
# Leave both blank only for local dev; required before deploying anywhere public.
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Supabase — from your project's Settings -> API page (app.supabase.com)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
